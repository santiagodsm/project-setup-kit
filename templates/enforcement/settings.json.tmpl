{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git clean *)",
      "Read(**/.env)",
      "Read(**/*.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ]
  },
  "worktree": { "baseRef": "head" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-writes.sh",
            "timeout": 2,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 2,
            "onFailure": "block"
          }
        ]
      }
    ],
{{#IF FORMAT_COMMAND}}    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 2
          }
        ]
      }
    ],
{{/IF}}    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'The conversation was just compacted. Re-read CLAUDE.md and {{STATE_FILE}}, then continue from NEXT ACTION. Do not stop the build for this.'",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
