#!/bin/sh
# Generated by harness-forge. Activated by: git config core.hooksPath .githooks
# Staged files only. Never runs tests or the check command: the full suite already runs where the
# tier says (once per story at small, once per join at orchestrated), and running it here would add
# a suite run per commit (KD-020 speed budget). harness-doctor blocks any test run in this file.

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -n "$staged" ] || exit 0

# Run a check, but never for longer than the budget. Past the budget it is killed and the
# commit goes ahead: a slow lint must not stall the build (KD-020 rule 6, fail open).
bounded() {
  limit=$1; shift
  "$@" & pid=$!
  ( trap 'exit 0' TERM; sleep "$limit" & wait $!; kill "$pid" ) >/dev/null 2>&1 & watcher=$!
  wait "$pid"; status=$?
  kill "$watcher" 2>/dev/null; wait "$watcher" 2>/dev/null
  if [ "$status" -eq 143 ]; then
    echo "pre-commit: '$1' ran past ${limit}s and was skipped (speed budget, fails open)." >&2
    return 0
  fi
  return "$status"
}
{{#IF ORCHESTRATED}}
# Rule: {{STATE_FILE}} is committed alone (design rulings in {{DESIGN}} may ride with it).
# Why: the orchestrator is its only writer and commits it by itself at each join
# (orchestrate-build, join step 10). A mixed commit means a unit agent wrote it.
if printf '%s\n' "$staged" | grep -qx '{{STATE_FILE}}'; then
  others=$(printf '%s\n' "$staged" | grep -vx -e '{{STATE_FILE}}' -e '{{DESIGN}}')
  if [ -n "$others" ]; then
    echo "pre-commit: rejected. {{STATE_FILE}} is staged together with other files:" >&2
    printf '  %s\n' $others >&2
    echo "Rule: only the orchestrator writes {{STATE_FILE}}, and it commits it alone (orchestrate-build rule 6, join step 10)." >&2
    echo "Unstage one side: git restore --staged {{STATE_FILE}}" >&2
    exit 1
  fi
fi
{{/IF}}{{#IF LINT_STAGED_COMMAND}}
# Lint the staged source files only.
set --
while IFS= read -r f; do
  [ -f "$f" ] || continue
  case " {{SOURCE_EXTENSIONS}} " in *" ${f##*.} "*) set -- "$@" "$f" ;; esac
done <<STAGED
$staged
STAGED
if [ "$#" -gt 0 ]; then
  if ! bounded 10 {{LINT_STAGED_COMMAND}} "$@"; then
    echo "pre-commit: rejected. Lint failed on the staged files above." >&2
    echo "Rule: every commit is lint-clean, and this hook is how the harness enforces it (kit KD-020). Fix the lint errors and commit again." >&2
    exit 1
  fi
fi
{{/IF}}{{#IF PRECOMMIT_TYPECHECK}}
# Type check, both tiers. At orchestrated each parallel unit commits from its own worktree,
# so a neighbour's half-written code is never in this tree (kit KD-023).
if ! bounded 5 {{TYPECHECK_COMMAND}}; then
  echo "pre-commit: rejected. Typecheck failed." >&2
  echo "Rule: every commit is type-clean, and this hook is how the harness enforces it (kit KD-020). Fix the type errors and commit again." >&2
  exit 1
fi
{{/IF}}
exit 0
